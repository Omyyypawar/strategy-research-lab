# ============================================================
# Binance API credentials
# ============================================================
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=True

# ============================================================
# Execution settings
# ============================================================
EXECUTE_ORDERS=False
SYMBOL=BTCUSDT
INTERVAL=1m
ORDER_COOLDOWN=30
LIMIT_TIMEOUT=2.0

# ============================================================
# Model paths
# ============================================================
MODEL_PATH=models/phase3_rf_v2.pkl
FEATURE_MANIFEST=models/features_columns_phase3_v2.json
# Ensemble model (Phase C default)
# MODEL_PATH=models/ensemble_v1.pkl

# ============================================================
# Risk management
# ============================================================
RISK_PER_TRADE=0.02
START_BALANCE=1000
DAILY_LOSS_LIMIT=0.1
MAX_DRAW_DOWN=0.2
MAX_CONSEC_LOSSES=5
MIN_ORDER_USD=5.0

# ============================================================
# Slippage and simulation
# ============================================================
SLIPPAGE_BASE=0.0005
SLIPPAGE_SCALE_BY_SIZE=1.0
VOL_ADJUST=1.0

# ============================================================
# Data and logging
# ============================================================
WARMUP_KLINES=500
LOOKBACK=2000
LOG_FILE=executor_v4_log.csv
METRICS_FILE=execution_metrics.csv
TRADES_FILE=executor_v4_trades.csv
